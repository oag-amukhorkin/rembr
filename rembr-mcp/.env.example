# Database (component-based connection, preferred for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rembr
DB_USER=rembr_app
DB_PASSWORD=your-db-password
DB_READ_HOST=localhost
DB_READ_PASSWORD=your-db-password

# Or use a connection string (takes precedence if set)
# DATABASE_URL="postgresql://rembr_app:password@localhost:5432/rembr"

# Redis (session store + embedding cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
# Or use a URL (takes precedence if set)
# REDIS_URL="redis://:password@localhost:6379"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here"
API_KEY_SECRET="generate-an-independent-random-value"

# Ollama Embedding Service
OLLAMA_HOST="http://localhost:11434"

# Or use any OpenAI-compatible embedding endpoint.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://localhost:4000/v1
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_DIMENSIONS=768

# Optional OpenAI-compatible text generation for relationship classification and
# background memory evolution. The LM_STUDIO_* names are retained for backwards
# compatibility; OpenAI-compatible gateways and local model servers work too.
TEXT_GENERATION_PROVIDER=openai-compatible
LM_STUDIO_BASE_URL=http://localhost:4000/v1
LM_STUDIO_MODEL=qwen3
TEXT_GENERATION_TIMEOUT_MS=180000
MEMORY_EVOLUTION_APPLY_ENABLED=true
MEMORY_EVOLUTION_ENABLED=true
MAINTENANCE_RELATIONSHIP_ENABLED=true
MAINTENANCE_CONTRADICTION_ENABLED=true
MAINTENANCE_CLEANUP_ENABLED=true
MAINTENANCE_EVOLUTION_BATCH_SIZE=2
MAINTENANCE_EVOLUTION_MIN_CONFIDENCE=0.85

# ─── Azure OpenAI provider (optional) ──────────────────────────────────────────
# Embeddings: EMBEDDING_PROVIDER=azure
# Text generation: TEXT_GENERATION_PROVIDER=azure (independent of embeddings)
# Azure is not drop-in OpenAI-compatible — it uses deployment-based URLs, an
# api-key header, and a native `dimensions` param. Set EMBEDDING_DIMENSIONS=768
# to match the pgvector schema.
# EMBEDDING_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT="https://my-resource.openai.azure.com"
# AZURE_OPENAI_API_KEY="your-azure-openai-key"
# AZURE_OPENAI_API_VERSION="2024-10-21"
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# AZURE_OPENAI_TEXT_DEPLOYMENT="gpt-5-mini"
# EMBEDDING_DIMENSIONS=768

# Disable SaaS request quotas only for a trusted private deployment.
RATE_LIMIT_DISABLED=false
