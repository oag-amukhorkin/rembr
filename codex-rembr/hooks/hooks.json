{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/recall-hook-cli.js\"",
            "timeout": 20,
            "statusMessage": "Recalling Rembr memories"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/stop-distill.ps1\"",
            "timeout": 30,
            "statusMessage": "Scheduling forced Rembr distillation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/stop-distill.ps1\"",
            "timeout": 30,
            "statusMessage": "Scheduling Rembr distillation"
          }
        ]
      }
    ]
  }
}
